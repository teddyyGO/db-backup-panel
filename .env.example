# Copy to .env for local dev. On a hosting platform, set these as service variables instead.
# The app refuses to start while APP_PASSWORD / APP_SECRET still hold these placeholders.

# Password to log into the backup panel. Choose something long and random.
APP_PASSWORD=change-me-to-a-long-password

# Secret used to encrypt the stored connection string and sign sessions.
# Generate one with:  npm run gen-secret
# IMPORTANT: never change this after storing a connection string, or it can't be decrypted.
APP_SECRET=change-me-generate-a-64-char-hex-secret

# Where backups + config are stored (point this at a persistent volume). Default: ./data
DATA_DIR=/data

# Port (most platforms set this automatically).
PORT=3000

# production enables Secure cookies + HSTS.
NODE_ENV=production

# Optional. Bind address (default 0.0.0.0). Use 127.0.0.1 to allow access only via SSH tunnel.
# BIND_HOST=127.0.0.1

# Optional. Override the cookie Secure flag (default: on when NODE_ENV=production).
# Only set false when the panel is reached over an SSH tunnel / localhost.
# COOKIE_SECURE=false

# Optional. Reverse-proxy hops to trust for the client IP (default 1).
# Set 0 if clients connect directly with no proxy in front.
# TRUST_PROXY=1

# Optional. Force a specific dump binary (default: mariadb-dump, then mysqldump).
# DUMP_BIN=mysqldump

# Optional. Extra flags appended to the dump command, space-separated.
# DUMP_EXTRA_ARGS=--set-gtid-purged=OFF

# Optional. Abort a single dump after this many minutes (default 60).
# DUMP_TIMEOUT_MIN=60
